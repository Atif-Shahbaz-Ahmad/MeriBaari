{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      // Never map `react` / `react-dom` here. Next.js JsConfigPathsPlugin
      // would rewrite those imports to node_modules and bypass the App
      // Router's layer-specific RSC vs SSR React.
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "@supabase/ssr": ["./node_modules/@supabase/ssr"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@hookform/resolvers": ["./node_modules/@hookform/resolvers"],
      "@hookform/resolvers/*": ["./node_modules/@hookform/resolvers/*"],
      "zod": ["./node_modules/zod"],
      "zustand": ["./node_modules/zustand"],
      "lucide-react": ["./node_modules/lucide-react"],
      "lucide-react-native": ["./src/shims/lucide-react-native.ts"],
      "@/lib/supabase": ["./src/lib/supabase.ts"],
      "@/lib/secure-store": ["./src/lib/storage.ts"],
      "@/lib/auth-redirect": ["./src/lib/auth-redirect.ts"],
      "@/lib/avatar-image": ["./src/lib/avatar-image.ts"],
      "@/lib/query-client": ["./src/lib/query-client.ts"],
      "@/lib/i18n/locale-context": ["./src/lib/locale-context.tsx"],
      "@/lib/i18n/rtl": ["./src/lib/rtl.ts"],
      "@/lib/geo": ["./src/lib/geo.ts"],
      "@/data": ["./src/di/index.ts"],
      "@/data/di": ["./src/di/index.ts"],
      "@/data/di/container": ["./src/di/container.ts"],
      "@/data/di/index": ["./src/di/index.ts"],
      "@/hooks/use-theme": ["./src/hooks/use-theme.ts"],
      "@/hooks/use-auth": ["./src/hooks/use-auth.ts"],
      "@/features/search/hooks/use-user-location": ["./src/hooks/use-user-location.ts"],
      "@/features/notifications/hooks/use-push-notifications": ["./src/hooks/use-push-notifications.ts"],
      "expo-web-browser": ["./src/shims/expo-web-browser.ts"],
      "expo-secure-store": ["./src/shims/expo-secure-store.ts"],
      "expo-linking": ["./src/shims/expo-linking.ts"],
      "expo-auth-session": ["./src/shims/expo-auth-session.ts"],
      "expo-image-manipulator": ["./src/shims/expo-image-manipulator.ts"],
      "expo-audio": ["./src/shims/expo-audio.ts"],
      "expo-notifications": ["./src/shims/expo-notifications.ts"],
      "expo-location": ["./src/shims/expo-location.ts"],
      "expo-constants": ["./src/shims/expo-constants.ts"],
      "expo-device": ["./src/shims/expo-device.ts"],
      "expo-file-system": ["./src/shims/expo-file-system.ts"],
      "expo-haptics": ["./src/shims/expo-haptics.ts"],
      "expo-router": ["./src/shims/expo-router.ts"],
      "expo-clipboard": ["./src/shims/expo-clipboard.ts"],
      "react-native": ["./src/shims/react-native.ts"],
      "@react-navigation/native": ["./src/shims/react-navigation.ts"],
      "@/*": ["../*"],
      "@web/*": ["./src/*"]
    }
  },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/types/global.d.ts"],
  "exclude": ["node_modules"]
}
