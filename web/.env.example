# Optional — the Next.js app also reads EXPO_PUBLIC_* from the repo-root .env.
# Never put service_role, Gemini, Deepgram, Azure, or Sentry auth tokens here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public DSN for the meribaari-web Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
# Optional override: development | preview | staging | production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Vercel / CI only (do not commit):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=meribaari-web
