{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/supabase": ["./src/lib/supabase.ts"],
      "@/lib/secure-store": ["../web/src/lib/storage.ts"],
      "@/lib/auth-redirect": ["./src/lib/auth-redirect.ts"],
      "@/lib/avatar-image": ["../web/src/lib/avatar-image.ts"],
      "@/lib/query-client": ["../web/src/lib/query-client.ts"],
      "@/lib/i18n/locale-context": ["../web/src/lib/locale-context.tsx"],
      "@/lib/i18n/rtl": ["../web/src/lib/rtl.ts"],
      "@/lib/geo": ["../web/src/lib/geo.ts"],
      "@/data": ["../web/src/di/index.ts"],
      "@/data/di": ["../web/src/di/index.ts"],
      "@/data/di/container": ["../web/src/di/container.ts"],
      "@/data/di/index": ["../web/src/di/index.ts"],
      "@/hooks/use-theme": ["../web/src/hooks/use-theme.ts"],
      "@/hooks/use-auth": ["../web/src/hooks/use-auth.ts"],
      "@/features/search/hooks/use-user-location": ["../web/src/hooks/use-user-location.ts"],
      "@/features/notifications/hooks/use-push-notifications": ["../web/src/hooks/use-push-notifications.ts"],
      "react-native": ["../web/src/shims/react-native.ts"],
      "expo-web-browser": ["../web/src/shims/expo-web-browser.ts"],
      "expo-secure-store": ["../web/src/shims/expo-secure-store.ts"],
      "expo-linking": ["../web/src/shims/expo-linking.ts"],
      "expo-auth-session": ["../web/src/shims/expo-auth-session.ts"],
      "expo-image-manipulator": ["../web/src/shims/expo-image-manipulator.ts"],
      "expo-audio": ["../web/src/shims/expo-audio.ts"],
      "expo-notifications": ["../web/src/shims/expo-notifications.ts"],
      "expo-location": ["../web/src/shims/expo-location.ts"],
      "expo-constants": ["../web/src/shims/expo-constants.ts"],
      "expo-device": ["../web/src/shims/expo-device.ts"],
      "expo-file-system": ["../web/src/shims/expo-file-system.ts"],
      "expo-haptics": ["../web/src/shims/expo-haptics.ts"],
      "expo-router": ["../web/src/shims/expo-router.ts"],
      "@react-navigation/native": ["../web/src/shims/react-navigation.ts"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/font/google": ["./src/shims/next-font.ts"],
      "next/headers": ["./src/shims/next-headers.ts"],
      "@supabase/supabase-js": ["../node_modules/@supabase/supabase-js"],
      "lucide-react-native": ["./node_modules/lucide-react"],
      "@/*": ["../*"],
      "@web/*": ["../web/src/*"],
      "@web-app/*": ["../web/app/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
