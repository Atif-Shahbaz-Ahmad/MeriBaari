# Expo / MeriBaari — public client configuration only.
# Never put service_role, Gemini, Deepgram, or Azure keys in this file.
#
# Used by:
#   Mobile (Expo)   EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY
#   Web (Next.js)   same values (NEXT_PUBLIC_* aliases are optional)
#   Desktop (Tauri) same values, baked in at `npm run desktop:build`
#
# Production clients (installable APK/IPA, desktop installer, hosted web)
# connect directly to this Supabase project. They do not use localhost,
# Next.js, or Metro as a content server.
# They must NOT point at localhost unless you are intentionally running
# a local Supabase stack in development.
#
# Copy to `.env` in the repo root.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional aliases for the Next.js web app. If unset, web/desktop reuse the
# EXPO_PUBLIC_* values from this file.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Customer / business chatbot (SERVER-SIDE ONLY — `npx supabase secrets set`):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Voice STT / TTS (SERVER-SIDE ONLY — `npx supabase secrets set`):
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=ur-PK-UzmaNeural
